# Server Configuration
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database Configuration (PostgreSQL + Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vaaris_db?schema=public

# Security & CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Future Auth & Storage Configuration (Placeholders)
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage Configuration (Future S3 / Cloud Storage)
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=vaaris-encrypted-vault
STORAGE_ACCESS_KEY=your-storage-access-key
STORAGE_SECRET_KEY=your-storage-secret-key
