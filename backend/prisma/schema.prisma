// VAARIS Database Schema — PostgreSQL + Prisma
// Core Architectural Principle: Family is the primary security & data boundary

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FamilyRole {
  PRIMARY_ADMIN
  DECISION_MAKER
  CONTINGENT_MEMBER
  VIEWER
  EMERGENCY_CONTACT
}

enum AccessStatus {
  ACTIVE
  PENDING_VERIFICATION
  CONTINGENT_LOCKED
  REVOKED
}

enum AuditAction {
  USER_REGISTERED
  USER_LOGIN
  FAMILY_CREATED
  MEMBER_ADDED
  MEMBER_UPDATED
  ACCESS_GRANTED
  ACCESS_REVOKED
  RECORD_CREATED
  RECORD_UPDATED
  DOCUMENT_UPLOADED
  EMERGENCY_CASE_OPENED
  CLAIM_STATUS_UPDATED
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  phoneNumber      String?        @unique
  fullName         String
  passwordHash       String?
  hashedRefreshToken String?
  isEmailVerified    Boolean        @default(false)
  isPhoneVerified  Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  createdFamilies  Family[]       @relation("FamilyCreator")
  familyAccesses   FamilyAccess[]
  familyMemberProfiles FamilyMember[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Family {
  id          String         @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy        User              @relation("FamilyCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members          FamilyMember[]
  accessList       FamilyAccess[]
  auditLogs        AuditLog[]
  financialRecords FinancialRecord[]
  documents        VaultDocument[]
  continuityPlan   ContinuityPlan?
  emergencyCases   EmergencyCase[]

  @@map("families")
}

model FamilyMember {
  id                 String     @id @default(uuid())
  familyId           String
  userId             String?
  name               String
  relationship       String
  age                Int?
  role               FamilyRole @default(DECISION_MAKER)
  phone              String?
  email              String?
  isEmergencyContact Boolean    @default(false)
  isPrimaryContact   Boolean    @default(false)
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  family             Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user               User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("family_members")
}

model FamilyAccess {
  id         String       @id @default(uuid())
  familyId   String
  userId     String
  role       FamilyRole   @default(VIEWER)
  status     AccessStatus @default(PENDING_VERIFICATION)
  grantedAt  DateTime     @default(now())
  revokedAt  DateTime?

  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_access")
}

model FinancialRecord {
  id                  String          @id @default(uuid())
  familyId            String
  name                String
  category            String          // e.g. bank_accounts, mutual_funds, insurance, loans_liabilities
  institution         String
  accountNumberMasked String?
  value               Float           @default(0) // Balance or valuation (negative or categorized as liability)
  isInsurance         Boolean         @default(false)
  insuranceCoverage   Float?          // Sum assured (strictly separated from cash asset value)
  nomineeStatus       String          @default("Not Added") // Verified, Needs Review, Action Required, Not Added
  source              String          @default("User provided")
  notes               String?
  actionRequired      String?
  lastReviewedDate    DateTime?       @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  family              Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nominees            Nominee[]
  linkedDocuments     VaultDocument[]

  @@index([familyId])
  @@map("financial_records")
}

model Nominee {
  id                String          @id @default(uuid())
  financialRecordId String
  name              String
  relationship      String
  sharePercentage   Float           @default(100)
  verifiedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  financialRecord   FinancialRecord @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)

  @@index([financialRecordId])
  @@map("nominees")
}

model VaultDocument {
  id              String           @id @default(uuid())
  familyId        String
  name            String
  category        String           // e.g. Identity Documents, Financial Documents, Insurance, Property
  linkedAssetId   String?
  linkedAssetName String?
  fileSizeBytes   Int              @default(0)
  status          String           @default("Document Processed") // Document Processed, AI Processing, Needs Verification
  storagePath     String?
  extractedData   Json?
  uploadDate      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  family          Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  linkedAsset     FinancialRecord? @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@map("vault_documents")
}

model ContinuityPlan {
  id                   String   @id @default(uuid())
  familyId             String   @unique
  completionPercentage Int      @default(0)
  emergencyContacts    Json?
  responsibilities     Json?
  financialIntents     Json?
  instructions         Json?
  emergencyAccessTiers Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  family               Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@map("continuity_plans")
}

model EmergencyCase {
  id               String   @id @default(uuid())
  familyId         String
  deceasedName     String
  relationship     String
  status           String   @default("Active") // Active, Under Review, Resolved
  dateReported     DateTime @default(now())
  knownAssetsValue Float    @default(0)
  milestones       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  family           Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  claims           Claim[]

  @@index([familyId])
  @@map("emergency_cases")
}

model Claim {
  id                     String        @id @default(uuid())
  caseId                 String
  familyId               String
  institution            String
  assetType              String
  assetName              String
  claimantName           String
  estimatedAmount        Float         @default(0)
  isInsurance            Boolean       @default(false)
  status                 String        @default("Documents Submitted")
  progressPercentage     Int           @default(20)
  nextStep               String
  steps                  Json?
  missingDocumentNotice  Json?
  assignedProfessionalId String?
  activityLog            Json?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  emergencyCase          EmergencyCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([familyId])
  @@map("claims")
}

model AuditLog {
  id           String      @id @default(uuid())
  familyId     String?
  userId       String?
  action       AuditAction
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime    @default(now())

  family       Family?     @relation(fields: [familyId], references: [id], onDelete: SetNull)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([userId])
  @@map("audit_logs")
}
